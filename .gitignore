# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets and local settings
.env
.env.*
.streamlit/secrets.toml

# Data: the full dataset and caches are large and are never committed.
# Only the small sample in data/sample/ is tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3

# Trained model files are rebuilt with scripts/train_models.py
models/*.joblib

# Tools and editors
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
